// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Grupos familiares o de acompañantes
/// Permite agrupar invitados para confirmaciones conjuntas
model Group {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(100)

  // Relaciones
  guests        Guest[]
  confirmations Confirmation[]

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Índices
  @@index([name], name: "idx_groups_name")
  // Constraints
  @@map("groups")
}

/// Invitados individuales
/// Código de invitación autogenerado de 6 dígitos numéricos
model Guest {
  id String @id @default(uuid()) @db.Uuid

  // Datos personales
  firstName String  @db.VarChar(50) @map("first_name")
  lastName  String  @db.VarChar(50) @map("last_name")
  phone     String? @db.VarChar(20)

  // Código único de invitación (6 dígitos, autogenerado por DB)
  code String @unique @default(dbgenerated("LPAD(FLOOR(RANDOM() * 900000 + 100000)::TEXT, 6, '0')")) @db.VarChar(6)

  // Relación con grupo (nullable - invitados individuales)
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_guests_group")
  groupId String? @db.Uuid @map("group_id")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones inversas
  confirmationsAsGuest     Confirmation[] @relation("GuestConfirmations")
  confirmationsAsConfirmer Confirmation[] @relation("ConfirmedBy")

  // Índices
  @@index([code], name: "idx_guests_code")
  @@index([groupId], name: "idx_guests_group_id")
  // Constraints
  @@map("guests")
}

/// Confirmaciones de asistencia
/// Una confirmación por invitado (constraint única)
model Confirmation {
  id String @id @default(uuid()) @db.Uuid

  // Eventos a los que asiste
  civilAttending Boolean @default(false) @map("civil_attending")
  partyAttending Boolean @default(false) @map("party_attending")

  // Invitado que está confirmando asistencia
  guest   Guest  @relation("GuestConfirmations", fields: [guestId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_confirmations_guest")
  guestId String @db.Uuid @map("guest_id")

  // Quién realizó la confirmación (puede ser diferente al invitado)
  confirmedBy   Guest  @relation("ConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_confirmations_confirmed_by")
  confirmedById String @db.Uuid @map("confirmed_by_id")

  // Grupo (para confirmaciones familiares conjuntas)
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_confirmations_group")
  groupId String? @db.Uuid @map("group_id")

  // Timestamps
  confirmedAt DateTime @default(now()) @map("confirmed_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Constraints
  @@unique([guestId], name: "uq_confirmations_guest_id")
  // Índices
  @@index([confirmedById], name: "idx_confirmations_confirmed_by_id")
  @@index([groupId], name: "idx_confirmations_group_id")
  @@index([confirmedAt], name: "idx_confirmations_confirmed_at")
  @@map("confirmations")
}


