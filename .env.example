# 📋 TEMPLATE DE VARIABLES DE ENTORNO
# Copiar este archivo a .env y completar con valores reales

# PostgreSQL Database URL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/wedding_invitation?schema=public"

# Ejemplos según el entorno:
#
# 🖥️  PostgreSQL Local (desarrollo):
# DATABASE_URL="postgresql://tom.pais@localhost:5432/wedding_invitation?schema=public"
#
# ☁️  Supabase (desarrollo/producción):
# DATABASE_URL="postgresql://postgres.xxxxx:YOUR_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# 🚀 Para Vercel (producción):
# No uses .env - configura DATABASE_URL en:
# https://vercel.com/[tu-proyecto]/settings/environment-variables


