    "framer-motion": "^12.34.0",
    "lottie-react": "^2.4.1",
    "next": "16.1.6",
    "pg": "^8.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-icons": "^5.5.0",
    "swiper": "^12.1.0",
